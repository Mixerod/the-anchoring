{
  "name": "the-anchoring",
  "version": "0.2.0",
  "description": "An intent graph in git, anchored to code, machine-checked. Makes a repository legible to agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kb": "./dist/cli.js",
    "anchoring": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "kb": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:depcruise": "depcruise src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run lint:depcruise && npm run test",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  },
  "author": "Mixerod",
  "keywords": [
    "agents",
    "ai-agents",
    "llm",
    "context",
    "prompt-caching",
    "architecture",
    "adr",
    "invariants",
    "dependency-cruiser",
    "eslint",
    "documentation",
    "knowledge-base",
    "codegraph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mixerod/the-anchoring.git"
  },
  "homepage": "https://github.com/Mixerod/the-anchoring#readme",
  "bugs": {
    "url": "https://github.com/Mixerod/the-anchoring/issues"
  }
}
