{
  "kbRoot": ".anchor",
  "kinds": {
    "ADR": {
      "dir": "docs/adr"
    },
    "INV": {
      "dir": ".anchor/invariant"
    },
    "FLOW": {
      "dir": ".anchor/flow"
    },
    "WORK": {
      "dir": ".anchor/work"
    },
    "INC": {
      "dir": ".anchor/incident"
    },
    "HAZ": {
      "dir": ".anchor/hazard"
    }
  },
  "governedPaths": [
    "src/"
  ],
  "hazard": {
    "openDays": 30,
    "ceiling": 24
  },
  "symbolIndex": "none",
  "architecture": {
    "layers": [
      {
        "name": "cli",
        "paths": [
          "src/cli.ts",
          "src/cli-upstream.ts"
        ]
      },
      {
        "name": "app",
        "paths": [
          "src/render.ts",
          "src/init.ts",
          "src/agents.ts"
        ]
      },
      {
        "name": "domain",
        "paths": [
          "src/config.ts",
          "src/config-architecture.ts",
          "src/store.ts",
          "src/verify.ts",
          "src/verify-upstream.ts",
          "src/verify-hazard.ts",
          "src/finding.ts",
          "src/why.ts",
          "src/ctx.ts",
          "src/done.ts",
          "src/guards.ts",
          "src/owners.ts",
          "src/model.ts",
          "src/frontmatter.ts",
          "src/anchors.ts",
          "src/upstream.ts"
        ],
        "pure": true
      },
      {
        "name": "infra",
        "paths": [
          "src/root.ts",
          "src/git.ts",
          "src/loader.ts",
          "src/resolver.ts",
          "src/session.ts"
        ]
      }
    ],
    "maxFileLines": 400,
    "maxFunctionLines": 50
  }
}
